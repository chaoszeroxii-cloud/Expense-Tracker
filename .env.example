# ── Database ─────────────────────────────────────────
DB_NAME=expense_tracker
DB_USER=expense_user
DB_PASSWORD=change_me_strong_password_here

# ── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_very_long_random_secret_minimum_32_chars

# ── Social Login ──────────────────────────────────────
# Google: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Facebook: https://developers.facebook.com → My Apps → Settings → Basic
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# ── URLs ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000    # prod: https://yourdomain.com

# ── AI (Phase 2) ─────────────────────────────────────
# OpenRouter API key — get at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-...

# Tavily Search — add as many keys as you want (free tier: 1,000 req/mo each)
# get at https://tavily.com
TAVILY_KEY_1=tvly-...
TAVILY_KEY_2=tvly-...
TAVILY_KEY_3=tvly-...
