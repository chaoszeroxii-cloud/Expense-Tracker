{
  "name": "expense-tracker-backend",
  "version": "1.0.0",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "test:mdi-icons": "npm run build && node --test test/mdi-icons.test.js",
    "test:schema-config": "npm run build && node --test test/database-schema-config.test.js",
    "test:cors-config": "npm run build && node --test test/cors-config.test.js",
    "//migrations": "The CLI runs against compiled output, so build first. `start:prod` is the Render start command: it applies pending migrations before booting.",
    "start:prod": "npm run migration:run && node dist/main",
    "migration:run": "typeorm migration:run -d dist/config/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/config/data-source.js",
    "migration:show": "typeorm migration:show -d dist/config/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/config/data-source.js",
    "test:e2e": "node .e2e/run.mjs",
    "test:planning": "node .e2e/planning.mjs",
    "test:allowance": "npm run build && node --test test/daily-allowance.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ipaddr.js": "^2.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "qs": "^6.16.0",
    "@nestjs/platform-express": {
      "multer": "^2.4.0",
      "body-parser": "^1.20.8"
    },
    "fflate": "^0.8.3",
    "brace-expansion@>=1 <2": "^1.1.21",
    "brace-expansion@>=2 <3": "^2.1.7",
    "ioredis": "^5.0.4"
  }
}
