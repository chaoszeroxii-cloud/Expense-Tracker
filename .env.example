# ── Database ─────────────────────────────────────────
DB_NAME=expense_tracker
DB_USER=expense_user
DB_PASSWORD=change_me_strong_password_here
# When connecting via DATABASE_URL, set to true once your provider's TLS chain
# is trusted by Node — validates the cert and blocks MITM. Default: false.
DB_SSL_REJECT_UNAUTHORIZED=false

# ── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production (>= 32 chars) — the app refuses to boot without it.
JWT_SECRET=change_me_very_long_random_secret_minimum_32_chars

# ── Social Login ──────────────────────────────────────
# Google: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Backend-side: same client id. When set, Google access tokens are verified to
# belong to this app (blocks token-substitution). Leave unset to skip (dev).
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Facebook: https://developers.facebook.com → My Apps → Settings → Basic
VITE_FACEBOOK_APP_ID=your_facebook_app_id
# Backend-side: verifies the FB token was issued for this app (debug_token).
# Both must be set to enable the check; leave unset to skip (dev).
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ── URLs ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000    # prod: https://yourdomain.com

# ── AI (Phase 2) ─────────────────────────────────────
# OpenRouter API key — get at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-...

# Per-user daily AI spend cap in THB. Requests are refused once a user exceeds
# it that day. Set to 0 to disable. Default: 50.
AI_DAILY_LIMIT_THB=50

# Tavily Search — add as many keys as you want (free tier: 1,000 req/mo each)
# get at https://tavily.com
TAVILY_KEY_1=tvly-...
TAVILY_KEY_2=tvly-...
TAVILY_KEY_3=tvly-...

# ── Daily reminder (Web Push) ────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Leave unset and the reminder section hides itself instead of offering a dead switch.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for POST /api/notifications/dispatch, so an external scheduler
# (cron-job.org, GitHub Actions) can trigger the sweep. The in-app cron runs
# every 5 minutes regardless; this is the fallback if the host sleeps.
CRON_SECRET=
